{
    "name": "wieslawgolec/plugin-wecom-campaign-alert",
    "description": "Mautic 7 plugin that sends real-time markdown alerts and stall notifications to WeCom (\u4f01\u4e1a\u5fae\u4fe1) group chat bots during marketing campaigns.",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": ["mautic", "plugin", "wecom", "qywx", "campaign", "alert", "webhook"],
    "extra": {
        "install-directory-name": "WeComCampaignAlertBundle"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mautic/core-lib": "Required when installed inside Mautic 7.2+ (^7.0)"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\WeComCampaignAlertBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\WeComCampaignAlertBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
